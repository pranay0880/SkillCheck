# Copy to .env.local and fill in. Set the same keys in Vercel for production.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=skilltest
# Password for the /admin area
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin and employee session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string

# Resend (https://resend.com) for one-time codes and "Email this link".
# Use an API key with "Sending access" for a domain you have verified in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=SkillCheck <noreply@your-domain.com>
# Public address used in invite emails, e.g. https://skillcheck.your-domain.com (optional; defaults to the request host)
# APP_URL=https://skillcheck.your-domain.com

# Optional, local only: use if you see "querySrv ECONNREFUSED" when connecting
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
